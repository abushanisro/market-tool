# Backend (Railway). Server-side only.
EMITHRAN_API_URL=http://localhost:8000
# Public base URL shown in code samples
NEXT_PUBLIC_API_BASE_URL=https://api.emithran.com

# Auth0 (Regular Web Application). See docs/DEPLOY.md.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=            # 32+ random bytes, e.g. `openssl rand -hex 32` (encrypts the session cookie)
APP_BASE_URL=http://localhost:3100
AUTH0_AUDIENCE=https://api.emithran.com   # the Auth0 API identifier; the backend checks the same value
