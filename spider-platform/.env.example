# Copy to .env and adjust.
MIP_CONTACT_EMAIL=data@your-company.com      # added to Crossref/OpenAlex polite-pool requests
MIP_ADMIN_TOKEN=change-me                    # X-Admin-Token for write operations + Developer Console sign-in
MIP_SECRET_KEY=                              # HMAC key for API v2 access tokens (generated and stored in the DB if empty)
MIP_MAX_PARALLEL_JOBS=2
MIP_GLOBAL_MAX_PAGES_PER_JOB=5000
# MIP_REPLAY_DIR=/app/tests/fixtures/replay  # offline demo: replay recorded real responses instead of network
# Optional credentials (only presence is shown in the UI):
# MIP_KEY_COMTRADE=
# MIP_KEY_DATA_GOV_IN=
# MIP_KEY_MATERIALS_PROJECT=
# MIP_KEY_OPENALEX=
# MIP_LLM_API_KEY=                           # enables the llm_extract parser (records always flagged ai_extracted)
