# Copy to .env and adjust.
MIP_CONTACT_EMAIL=data@your-company.com      # added to Crossref/OpenAlex polite-pool requests
MIP_ADMIN_TOKEN=change-me                    # X-Admin-Token for write operations + Developer Console sign-in
MIP_SECRET_KEY=                              # HMAC key for API v2 access tokens (generated and stored in the DB if empty)
MIP_MAX_PARALLEL_JOBS=2
# MIP_GO_FETCHER_BIN=/path/to/mip-fetch          # Go fetch worker (go-fetcher/); set automatically in Docker. Unset → Scrapy only
# MIP_GO_FETCHER_API=http://127.0.0.1:8000      # control-plane URL the Go worker calls
MIP_GLOBAL_MAX_PAGES_PER_JOB=5000
# MIP_REPLAY_DIR=/app/tests/fixtures/replay  # offline demo: replay recorded real responses instead of network
# Optional credentials (only presence is shown in the UI):
# MIP_KEY_COMTRADE=
# MIP_KEY_DATA_GOV_IN=
# MIP_KEY_MATERIALS_PROJECT=
# MIP_KEY_OPENALEX=
# MIP_LLM_API_KEY=                           # enables the llm_extract parser (records always flagged ai_extracted)

# --- Agent Intelligence: language models (all optional; agents run rules-only without them) ---
# Local models need no key: install Ollama or LM Studio and pick a model in Agent Intelligence -> Model setup.
# MIP_KEY_OPENROUTER=
# MIP_KEY_GOOGLE_AI=          # Google AI Studio (Gemma / Gemini)
# MIP_KEY_NVIDIA=             # build.nvidia.com (Nemotron and others)
# MIP_KEY_GROQ=
# MIP_KEY_CEREBRAS=
# MIP_KEY_MISTRAL=
# MIP_KEY_HUGGINGFACE=
