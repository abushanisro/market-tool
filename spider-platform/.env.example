# Copy to .env and adjust.
#
# --- Sign-in (Auth0). Unset = the API is OPEN: development only. See docs/DEPLOY.md.
# EMITHRAN_ENV=production                   # refuses to start without the three values below
# EMITHRAN_AUTH0_DOMAIN=your-tenant.us.auth0.com
# EMITHRAN_AUTH0_AUDIENCE=https://api.emithran.com   # the Auth0 API identifier
# EMITHRAN_ADMIN_TOKEN is the machine secret for the Go fetch worker (/api/fetcher); in production it is never a user login.
EMITHRAN_CONTACT_EMAIL=data@your-company.com      # added to Crossref/OpenAlex polite-pool requests
EMITHRAN_ADMIN_TOKEN=change-me                    # machine secret (X-Admin-Token) for the Go fetch worker; in development it also guards writes
EMITHRAN_SECRET_KEY=                              # HMAC key for API v2 access tokens (generated and stored in the DB if empty)
EMITHRAN_MAX_PARALLEL_JOBS=2
# EMITHRAN_GO_FETCHER_BIN=/path/to/emithran-fetch          # Go fetch worker (go-fetcher/); set automatically in Docker. Unset → Scrapy only
# EMITHRAN_GO_FETCHER_API=http://127.0.0.1:8000      # control-plane URL the Go worker calls
EMITHRAN_GLOBAL_MAX_PAGES_PER_JOB=5000
# EMITHRAN_REPLAY_DIR=/app/tests/fixtures/replay  # offline demo: replay recorded real responses instead of network
# Optional credentials (only presence is shown in the UI):
# EMITHRAN_KEY_COMTRADE=
# EMITHRAN_KEY_DATA_GOV_IN=
# EMITHRAN_KEY_MATERIALS_PROJECT=
# EMITHRAN_KEY_OPENALEX=
# EMITHRAN_LLM_API_KEY=                           # enables the llm_extract parser (records always flagged ai_extracted)

# --- Agent Intelligence: language models (all optional; agents run rules-only without them) ---
# Local models need no key: install Ollama or LM Studio and pick a model in Agent Intelligence -> Model setup.
# EMITHRAN_KEY_OPENROUTER=
# EMITHRAN_KEY_GOOGLE_AI=          # Google AI Studio (Gemma / Gemini)
# EMITHRAN_KEY_NVIDIA=             # build.nvidia.com (Nemotron and others)
# EMITHRAN_KEY_GROQ=
# EMITHRAN_KEY_CEREBRAS=
# EMITHRAN_KEY_MISTRAL=
# EMITHRAN_KEY_HUGGINGFACE=
